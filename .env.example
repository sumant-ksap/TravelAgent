TELEGRAM_BOT_TOKEN=
OLLAMA_API_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:31b-cloud
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/telegram_chat
HISTORY_LIMIT=20

# Optional: only needed to call Ollama Cloud directly over HTTPS instead of a
# local `ollama serve` (e.g. when deploying somewhere without a signed-in local
# Ollama, like Render - see the README's "Deploying to Render" section). Get a
# key at https://ollama.com/settings/keys and also set
# OLLAMA_API_HOST=https://ollama.com when using this.
OLLAMA_API_KEY=

# Optional: enables real flight/hotel search (Flight & Hotel agents) via the
# Amadeus for Developers self-service test API (free signup at
# https://developers.amadeus.com). Leave blank to keep Flight/Hotel agents on
# web-search-based research with no invented prices.
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
AMADEUS_API_HOST=https://test.api.amadeus.com
